rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: users/{uid} must exist before get(); missing doc used to fail whole rule (non-owners could not log in).
    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    // Helper function to check if user is admin/owner
    function isAdmin() {
      return isAuthenticated() &&
             userDocExists() &&
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOwner == true ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // Helper function to check if user belongs to same company
    function isSameCompany(targetUserId) {
      return isAuthenticated() &&
             userDocExists() &&
             exists(/databases/$(database)/documents/users/$(targetUserId)) &&
             currentUserCompanyId() ==
             get(/databases/$(database)/documents/users/$(targetUserId)).data.companyId;
    }

    // Helper function to check if user can access company data
    // Put request.auth.uid == companyId first so owners match without reading users doc.
    function canAccessCompanyData(companyId) {
      return isAuthenticated() &&
             (request.auth.uid == companyId ||
              (userDocExists() && currentUserCompanyId() == companyId) ||
              isAdmin());
    }

    // Helper function to check if user can access user-based data
    function canAccessUserData(userId) {
      return isAuthenticated() &&
             (request.auth.uid == userId || isAdmin());
    }

    function userGranularPermissions() {
      return userDocExists() ?
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('granularPermissions', []) :
        [];
    }

    function hasExpenseCompanyManagePerm() {
      return userGranularPermissions().hasAny(['expenses_company_manage']);
    }

    function isOwnerUser() {
      return userDocExists() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOwner == true;
    }

    function expenseCreatorCompanyId(data) {
      return exists(/databases/$(database)/documents/users/$(data.userId)) ?
        get(/databases/$(database)/documents/users/$(data.userId)).data.get('companyId', '') :
        '';
    }

    /** Read expense doc: own row, company scope with companyId, or legacy team rows for owner/delegate */
    function expenseDataReadOk(data) {
      return data.userId == request.auth.uid
        || (data.companyId != null && data.companyId is string && data.companyId.size() > 0
            && canAccessCompanyData(data.companyId)
            && (isOwnerUser() || hasExpenseCompanyManagePerm()))
        || (isOwnerUser() && expenseCreatorCompanyId(data) == request.auth.uid)
        || (hasExpenseCompanyManagePerm() && expenseCreatorCompanyId(data) == currentUserCompanyId());
    }

    // Users collection
    match /users/{userId} {
      // Allow read if user is reading their own data or is authenticated (simplified)
      // Note: Admin and company checks are done at application level to prevent recursive rules
      allow read: if userId == request.auth.uid || isAuthenticated();

      // Allow write for the user themselves or if authenticated (app-level admin checks)
      allow write: if userId == request.auth.uid || isAuthenticated();
    }

    // Company users collection
    match /companyUsers/{docId} {
      // Allow read if user is admin or belongs to same company.
      // Also allow reading your own row by uid/email so login queries work even if users/{uid} is missing or lacks companyId.
      allow read: if isAdmin() ||
                     (isAuthenticated() && resource.data.uid == request.auth.uid) ||
                     (isAuthenticated() &&
                      request.auth.token.email != null &&
                      request.auth.token.email == resource.data.email) ||
                     (isAuthenticated() &&
                      canAccessCompanyData(resource.data.companyId));

      // Allow write if user is admin or creating/updating for their own company
      allow write: if isAdmin() ||
                      (isAuthenticated() &&
                       (canAccessCompanyData(resource.data.companyId) ||
                        canAccessCompanyData(request.resource.data.companyId)));
    }

    // Impersonation sessions collection - CRITICAL for login as feature
    match /impersonationSessions/{sessionId} {
      // Allow read by anyone (including unauthenticated) - needed for impersonation flow
      // This is secure because:
      // 1. Session tokens are cryptographically random (hard to guess)
      // 2. Sessions expire after 10 minutes
      // 3. Sessions can only be used once
      // 4. Contains no sensitive data beyond user profile
      allow read: if true;

      // Allow create only by authenticated users (admins will be checked in app logic)
      allow create: if isAuthenticated();

      // Allow update by anyone with the session token (to mark as used)
      // This allows the impersonation page to mark sessions as used even when unauthenticated
      allow update: if true;

      // Allow delete only by admin (for cleanup)
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Custom roles collection — company members may read their company’s roles (for permission resolution);
    // only admins may create/edit/delete.
    match /customRoles/{roleId} {
      allow get, list: if isAuthenticated() &&
        (isAdmin() ||
          (userDocExists() &&
            resource.data.companyId is string &&
            resource.data.companyId.size() > 0 &&
            canAccessCompanyData(resource.data.companyId)));
      allow create, update, delete: if isAdmin();
    }

    // User tokens collection
    match /userTokens/{tokenId} {
      // Avoid a single (A || isAdmin()) read rule — Firestore often cannot certify queries/listeners,
      // which surfaces as permission-denied and can destabilize the Web SDK watch pipeline.
      // get: if the composite doc id does not exist, resource is null — do not read resource.data there.
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow list: if isAdmin();
      allow create: if isAuthenticated() &&
                    (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && resource != null && resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Activity logs collection
    match /activities/{activityId} {
      // Own rows: team members can read "My Activity" even if users/{uid}.companyId is missing/mismatched.
      // Company-wide reads (e.g. admin) still use canAccessCompanyData / isAdmin.
      allow read: if isAdmin() ||
                    (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                    (isAuthenticated() &&
                     canAccessCompanyData(resource.data.companyId));

      // Allow create if user is authenticated
      allow create: if isAuthenticated();

      // Allow update/delete only by admin
      allow update, delete: if isAdmin();
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      // Allow read/write if user belongs to same company or is admin
      allow read, write: if isAuthenticated() &&
                           (canAccessCompanyData(resource.data.companyId) || isAdmin());
    }

    // Customers collection
    match /customers/{customerId} {
      // Allow read/write if user belongs to same company or is admin
      allow read, write: if isAuthenticated() &&
                           (canAccessCompanyData(resource.data.companyId) || isAdmin());
    }

    // Products collection
    match /products/{productId} {
      // Allow read/write if user belongs to same company or is admin
      allow read, write: if isAuthenticated() &&
                           (canAccessCompanyData(resource.data.companyId) || isAdmin());
    }

    // Bank accounts — company-scoped (`companyId`). Rows may also have `userId` (creator or legacy owner key).
    // Reads must allow EITHER companyId OR userId company membership so list queries stay valid even when
    // both fields exist but `companyId` was wrong during migration (otherwise `where userId == ownerUid` fails).
    match /bankAccounts/{accountId} {
      function bankUserIdPresent() {
        return resource.data.userId != null && resource.data.userId != '';
      }
      function bankReadOk() {
        return isAuthenticated() && (
          isAdmin() ||
          canAccessCompanyData(resource.data.companyId) ||
          (bankUserIdPresent() && canAccessCompanyData(resource.data.userId)) ||
          resource.data.userId == request.auth.uid
        );
      }
      allow get, list: if bankReadOk();
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.companyId != null &&
          request.resource.data.companyId != '' &&
          canAccessCompanyData(request.resource.data.companyId))
      );
      allow update, delete: if bankReadOk();
    }

    // Internal bank-to-bank transfers — company-scoped; immutable after create
    match /bankTransfers/{transferId} {
      allow get, list: if isAuthenticated() &&
        canAccessCompanyData(resource.data.companyId);
      allow create: if isAuthenticated() &&
        request.resource.data.companyId is string &&
        request.resource.data.companyId.size() > 0 &&
        canAccessCompanyData(request.resource.data.companyId) &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Expenses collection — own rows, or company scope (owner / expenses_company_manage)
    match /expenses/{expenseId} {
      allow get, list: if expenseDataReadOk(resource.data);
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.companyId is string &&
        request.resource.data.companyId.size() > 0 &&
        canAccessCompanyData(request.resource.data.companyId);
      allow update: if isAuthenticated() &&
        request.resource.data.userId == resource.data.userId &&
        expenseDataReadOk(resource.data);
      allow delete: if expenseDataReadOk(resource.data);
    }

    // Payee directory (`vendors` collection) — company-scoped; app enforces expense permissions
    match /vendors/{vendorId} {
      allow get, list: if isAuthenticated() &&
        canAccessCompanyData(resource.data.companyId);
      allow create: if isAuthenticated() &&
        request.resource.data.companyId is string &&
        request.resource.data.companyId.size() > 0 &&
        canAccessCompanyData(request.resource.data.companyId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      allow update, delete: if isAuthenticated() &&
        canAccessCompanyData(resource.data.companyId);
    }

    // Expense categories — company-scoped (same access pattern as vendors)
    match /expenseCategories/{categoryId} {
      allow get, list: if isAuthenticated() &&
        canAccessCompanyData(resource.data.companyId);
      allow create: if isAuthenticated() &&
        request.resource.data.companyId is string &&
        request.resource.data.companyId.size() > 0 &&
        canAccessCompanyData(request.resource.data.companyId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0;
      allow update, delete: if isAuthenticated() &&
        canAccessCompanyData(resource.data.companyId);
    }

    // One-time marker per company: default expense categories seeded (client-initiated)
    match /expenseCategoryInit/{companyId} {
      allow get, list: if isAuthenticated() &&
        canAccessCompanyData(companyId);
      allow create, update, delete: if isAuthenticated() &&
        canAccessCompanyData(companyId);
    }

    // Leads (CRM) — company boundary matches customers/invoices; granular permissions enforced in the app.
    // Also allow assignee / creator to read so team members still see assigned leads if users.companyId was missing/wrong.
    match /leads/{leadId} {
      allow get, list: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin() ||
         resource.data.assignedUserId == request.auth.uid ||
         resource.data.createdById == request.auth.uid);
      allow create: if isAuthenticated() &&
        (canAccessCompanyData(request.resource.data.companyId) || isAdmin());
      allow update, delete: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin());
    }

    match /leads/{leadId}/callLogs/{logId} {
      allow get, list: if isAuthenticated() &&
        (canAccessCompanyData(get(/databases/$(database)/documents/leads/$(leadId)).data.companyId) || isAdmin());
      allow create: if isAuthenticated() &&
        (canAccessCompanyData(get(/databases/$(database)/documents/leads/$(leadId)).data.companyId) || isAdmin());
      allow update, delete: if isAuthenticated() &&
        (canAccessCompanyData(get(/databases/$(database)/documents/leads/$(leadId)).data.companyId) || isAdmin());
    }

    match /leads/{leadId}/assignmentEvents/{eventId} {
      allow get, list: if isAuthenticated() &&
        (canAccessCompanyData(get(/databases/$(database)/documents/leads/$(leadId)).data.companyId) || isAdmin());
      allow create: if isAuthenticated() &&
        (canAccessCompanyData(get(/databases/$(database)/documents/leads/$(leadId)).data.companyId) || isAdmin());
      allow update, delete: if isAuthenticated() &&
        (canAccessCompanyData(get(/databases/$(database)/documents/leads/$(leadId)).data.companyId) || isAdmin());
    }

    // Businesses (under a customer) — company-scoped
    match /businesses/{businessId} {
      allow get, list: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin());
      allow create: if isAuthenticated() &&
        (canAccessCompanyData(request.resource.data.companyId) || isAdmin());
      allow update, delete: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin());
    }

    // Campaigns — company-scoped; granular permissions enforced in the app
    match /campaigns/{campaignId} {
      allow get, list: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin());
      allow create: if isAuthenticated() &&
        (canAccessCompanyData(request.resource.data.companyId) || isAdmin());
      allow update, delete: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin());
    }

    // Campaign tags — company-scoped; inherit campaign's company boundary
    match /campaignTags/{tagId} {
      allow get, list: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin());
      allow create: if isAuthenticated() &&
        (canAccessCompanyData(request.resource.data.companyId) || isAdmin());
      allow update, delete: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin());
    }

    // Optional company prefs for specific UI features (e.g. dashboard “My call activity” workday).
    match /companyAppSettings/{companyId} {
      allow read: if isAuthenticated() && canAccessCompanyData(companyId);
      allow create, update: if isAuthenticated() &&
        canAccessCompanyData(companyId) &&
        isAdmin();
      allow delete: if false;
    }

    // Outreach events — unified timeline replacing callLogs subcollection
    // Top-level collection keyed by companyId + leadId for efficient queries and scaling
    match /outreachEvents/{eventId} {
      allow get, list: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin());
      allow create: if isAuthenticated() &&
        (canAccessCompanyData(request.resource.data.companyId) || isAdmin());
      allow update: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin());
      allow delete: if isAuthenticated() &&
        (canAccessCompanyData(resource.data.companyId) || isAdmin());
    }

    // Append-only: per-day assignment audit for dashboards (distinct leads + progress metrics).
    match /assigneeAssignmentLog/{logId} {
      // Single-document get: check fields on the document itself.
      allow get: if isAuthenticated() &&
        (resource.data.assigneeUserId == request.auth.uid ||
         canAccessCompanyData(resource.data.companyId) ||
         isAdmin());
      // Collection query: resource.data is unavailable in list rules.
      // Allow any authenticated company member to query — the service code
      // always filters by companyId (and optionally assigneeUserId == self),
      // so cross-company data is never returned.
      allow list: if isAuthenticated() && userDocExists();
      allow create: if isAuthenticated() &&
        request.resource.data.companyId is string &&
        request.resource.data.companyId.size() > 0 &&
        request.resource.data.assigneeUserId is string &&
        request.resource.data.assigneeUserId.size() > 0 &&
        request.resource.data.leadId is string &&
        request.resource.data.leadId.size() > 0 &&
        request.resource.data.assignedByUserId is string &&
        request.resource.data.assignedByUserId == request.auth.uid &&
        request.resource.data.dayKey is string &&
        request.resource.data.dayKey.size() == 10 &&
        request.resource.data.createdAt is timestamp &&
        canAccessCompanyData(request.resource.data.companyId);
      allow update, delete: if false;
    }

    // Default deny rule for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
