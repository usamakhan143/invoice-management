{
  "name": "invoicer-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bos:validate": "npx tsx scripts/run-bos-converter-checks.ts",
    "test": "vitest run",
    "test:bos": "vitest run bos/ --exclude bos/infrastructure/firestore/repositories/bosRepositories.integration.test.ts",
    "test:bos:completion": "vitest run bos/application/milestoneCompletionForm.test.ts",
    "test:bos:integration": "firebase emulators:exec --only firestore,auth \"vitest run bos/infrastructure/firestore/repositories/bosRepositories.integration.test.ts\"",
    "cleanup-db": "node scripts/cleanup-database.js --confirm",
    "migrate-products": "node scripts/migrate-products.js --confirm"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.2.7",
    "@react-pdf/renderer": "^4.3.0",
    "firebase": "^11.9.1",
    "libphonenumber-js": "^1.12.41",
    "luxon": "^3.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "firebase-admin": "^12.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
