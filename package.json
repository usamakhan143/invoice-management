{
  "name": "invoicer-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "bos:validate": "npx tsx scripts/run-bos-converter-checks.ts",
    "aos:validate": "npx tsx scripts/run-aos-converter-checks.ts",
    "aos:import-boundaries": "npx tsx scripts/verify-aos-import-boundaries.ts",
    "aos:security": "npx tsx scripts/verify-aos-firestore-security.ts",
    "test": "vitest run",
    "test:aos": "vitest run aos/ --exclude 'aos/infrastructure/integration/**'",
    "test:aos:integration": "firebase emulators:exec --only firestore,auth \"vitest run aos/infrastructure/integration/ --pool=forks --fileParallelism=false --sequence.concurrent=false\"",
    "test:aos:integration:delivery": "firebase emulators:exec --only firestore,auth \"vitest run aos/infrastructure/integration/deliveryStack.integration.test.ts\"",
    "test:aos:e2e": "firebase emulators:exec --only firestore,auth \"npx playwright test --config=playwright.config.ts\"",
    "test:bos": "vitest run bos/ --exclude bos/infrastructure/firestore/repositories/bosRepositories.integration.test.ts",
    "test:bos:completion": "vitest run bos/application/milestoneCompletionForm.test.ts",
    "test:bos:integration": "firebase emulators:exec --only firestore,auth \"vitest run bos/infrastructure/firestore/repositories/bosRepositories.integration.test.ts\"",
    "cleanup-db": "node scripts/cleanup-database.js --confirm",
    "migrate-products": "node scripts/migrate-products.js --confirm"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.2.7",
    "@react-pdf/renderer": "^4.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-virtual": "^3.14.6",
    "firebase": "^11.9.1",
    "libphonenumber-js": "^1.12.41",
    "luxon": "^3.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "axe-core": "^4.12.1",
    "firebase-admin": "^12.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
